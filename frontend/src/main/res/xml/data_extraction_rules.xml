<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule for both cloud backup and device-to-device transfer: tokens stay on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="civic_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="civic_session.xml" />
    </device-transfer>
</data-extraction-rules>
